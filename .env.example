NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_REQUIRED=false
# Mobile OTP sign-in. Turn on only after an SMS provider is connected in
# Supabase (Auth → Phone); until then the Mobile tab points users to email.
NEXT_PUBLIC_PHONE_LOGIN_ENABLED=false
# Marketing tools (strategy, plays, calendar, track) are outside the MVP. Leave
# false to hide them; nothing is deleted.
NEXT_PUBLIC_SHOW_GTM_TOOLS=false
# Keep false in shared or production environments. Set true only for local UI testing with legacy draft records.
NEXT_PUBLIC_SHOW_LEGACY_DRAFT_CATALOG=false
# Founder-authorized research beta: shows source-backed records while editorial review continues.
CATALOG_RESEARCH_BETA=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by ingestion workers; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=high
FIRECRAWL_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Resend is enabled after a verified sending domain is provisioned.
RESEND_API_KEY=
DOCUMENT_SCANNER_PROVIDER=
DOCUMENT_SCAN_WEBHOOK_SECRET=
